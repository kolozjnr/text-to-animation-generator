APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Uploaded originals are stored in private Cloudinary storage.
# Extracted JSON artifacts use a private local disk by default.
# The upload limit matches PHP's current 2 MB upload_max_filesize. Raise this only
# after upload_max_filesize and post_max_size have been increased.
DOCUMENTS_DISK=local
DOCUMENTS_MAX_SIZE_KB=2048
DOCUMENTS_QUEUE=documents
DOCUMENTS_EXTRACTION_DISK=local
DOCUMENTS_EXTRACTION_DIRECTORY=extractions
DOCUMENTS_MIN_TEXT_CHARACTERS=20
DOCUMENTS_MAX_ARTIFACT_BYTES=10485760
DOCUMENTS_DOCX_MAX_ENTRIES=2000
DOCUMENTS_DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCUMENTS_DOCX_MAX_COMPRESSION_RATIO=100

# Cloudinary source-document storage. Existing credential keys are reused.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DOCUMENT_FOLDER=source-documents
CLOUDINARY_DOCUMENT_DELIVERY_TYPE=private
CLOUDINARY_TIMEOUT_SECONDS=120
CLOUDINARY_CONNECT_TIMEOUT_SECONDS=10
CLOUDINARY_DOWNLOAD_EXPIRY_SECONDS=900

# Separate Docling extraction service. Bind it to localhost in development.
DOCLING_SERVE_URL=http://127.0.0.1:5001
DOCLING_SERVE_API_KEY=
DOCLING_TIMEOUT_SECONDS=240
DOCLING_CONNECT_TIMEOUT_SECONDS=5
DOCLING_DOCUMENT_TIMEOUT_SECONDS=180
DOCLING_MAX_PAGES=200
DOCLING_OCR_ENABLED=false
DOCLING_OCR_LANG=en
DOCLING_TABLE_STRUCTURE=true
DOCLING_HEADING_HIERARCHY=true
DOCLING_VERIFY_SSL=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
